#!/bin/sh
# Snapshot every server folder to restic (run nightly by mc-backup.timer).
# World saving is paused for the snapshot and always switched back on.
set -eu
umask 077
set -a; . /etc/mc-backup.env; set +a

paused=""
resume() {
    for s in $paused; do mc-rcon "$s" save-on || true; done
    paused=""
}
trap resume EXIT
trap 'exit 1' INT TERM

restic cat config >/dev/null 2>&1 || restic init

for unit in $(systemctl list-units --state=active --plain --no-legend 'mc@*' | awk '{print $1}'); do
    s=${unit#mc@}; s=${s%.service}
    [ "$s" = velocity ] && continue
    mc-rcon "$s" save-off
    paused="$paused $s"
    mc-rcon "$s" save-all flush
done

mysqldump --single-transaction --databases luckperms libertybans > /var/backups/mariadb.sql
# The bot's records and /link accounts (copied consistently while it runs) and its own small database.
extra=""
if [ -f /home/bot/pw-server/bot/bridge.db ]; then
    sqlite3 /home/bot/pw-server/bot/bridge.db ".backup /var/backups/bridge.db"
    extra="/var/backups/bridge.db"
fi
if [ -f /home/bot/pw-server/bot/database.yml ]; then
    extra="$extra /home/bot/pw-server/bot/database.yml"
fi
# Players' /kit kits (mods/kits), shared by fpv and plots outside their folders.
if [ -d /home/mc/kits ]; then
    extra="$extra /home/mc/kits"
fi
restic backup /home/mc/servers /var/backups/mariadb.sql $extra \
    --exclude '*.jar' --exclude libraries --exclude logs --exclude versions --exclude .fabric
resume

restic forget --prune --keep-daily 7 --keep-weekly 4 --keep-monthly 6
