#!/bin/sh
# Turn the proxy's maintenance mode on or off from the shell: mc-maintenance on|off
# Types it into the velocity console and waits until the plugin has saved it.
case "$1" in
    on) want=true ;;
    off) want=false ;;
    *) echo "usage: mc-maintenance on|off"; exit 1 ;;
esac
if [ "$(id -un)" != "mc" ]; then
    exec sudo -u mc "$0" "$@"
fi
config=/home/mc/servers/velocity/plugins/maintenance/config.yml
tmux -L velocity send-keys -t velocity -l "maintenance $1" || exit 1
tmux -L velocity send-keys -t velocity Enter
for i in $(seq 30); do
    grep -q "^maintenance-enabled: $want" "$config" && { echo "Maintenance is $1."; exit 0; }
    sleep 1
done
echo "Maintenance did not turn $1 (see mc-console velocity)."
exit 1
