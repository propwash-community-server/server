#!/usr/bin/env python3
"""Send one command over RCON and print the reply: mc-rcon <server> <command...>"""
import socket
import struct
import sys

server, command = sys.argv[1], " ".join(sys.argv[2:])
props = {}
with open(f"/home/mc/servers/{server}/server.properties") as f:
    for line in f:
        if "=" in line and not line.startswith("#"):
            key, value = line.rstrip("\n").split("=", 1)
            props[key] = value


def send(sock, kind, payload):
    body = struct.pack("<ii", 0, kind) + payload.encode() + b"\x00\x00"
    sock.sendall(struct.pack("<i", len(body)) + body)
    size = struct.unpack("<i", sock.recv(4))[0]
    data = b""
    while len(data) < size:
        data += sock.recv(size - len(data))
    request_id = struct.unpack("<i", data[:4])[0]
    return request_id, data[8:-2].decode()


with socket.create_connection(("127.0.0.1", int(props["rcon.port"])), timeout=300) as sock:
    if send(sock, 3, props["rcon.password"])[0] == -1:
        sys.exit("rcon: wrong password")
    print(send(sock, 2, command)[1])
