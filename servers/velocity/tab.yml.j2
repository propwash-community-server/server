# TAB's config.yml, written by the deploy; entries per player are in files/plugins/tab/groups.yml.
# https://github.com/NEZNAMY/TAB/wiki
# TAB rewrites the file (and the deploy then restarts the proxy) when a key is missing, so unused
# features still have their keys.
header-footer:
  enabled: false

tablist-name-formatting:
  enabled: true
  disable-condition: ""

scoreboard-teams:
  enabled: true
  enable-collision: false
  invisible-nametags: false
  # Highest role first, as the prefix in permissions.toml says.
  sorting-types:
    - "PLACEHOLDER_HIGH_TO_LOW:%luckperms-weight%"
    - "PLACEHOLDER_A_TO_Z:%server%"
    - "PLACEHOLDER_A_TO_Z:%player%"
  case-sensitive-sorting: false
  can-see-friendly-invisibles: false
  disable-condition: ""

# Everyone's ping as the number in the tab list, seen only by staff (propwash.ping.others).
playerlist-objective:
  enabled: true
  title: Ping
  value: "%ping%"
  # What 1.20.3+ clients show in place of the number.
  fancy-value: "<gray>%ping% ms</gray>"
  render-type: INTEGER
  disable-condition: "%condition:ping-viewer%=no"

belowname-objective:
  enabled: false
  fancy-value-default: NPC
  fancy-value: ""

prevent-spectator-effect:
  enabled: false

bossbar:
  enabled: false

scoreboard:
  enabled: false

layout:
  enabled: false

ping-spoof:
  enabled: false

# Everyone sees the players of every server.
global-playerlist:
  enabled: true
  display-others-as-spectators: false
  display-vanished-players-as-spectators: true
  isolate-unlisted-servers: false
  update-latency: false
  spy-servers: []
  server-groups: {}

placeholders:
  date-format: "dd.MM.yyyy"
  time-format: "HH:mm:ss"
  time-offset: 0
  register-tab-expansion: false
  locale: en-US

placeholder-refresh-intervals:
  default-refresh-interval: 500

# TAB-Bridge on freestyle and race reports a map's dimension maps:<name> (or worlds:<name>) as the world
# world_<name>, and the overworld as world. Other servers have no TAB-Bridge, so there %world% is still the
# last one, and the map condition leaves it out. Race shows a track's /race name ("[race: Laminar I]"),
# freestyle the world name; a world on both gets a race-<name> condition (deploy.py tab_world_names).
placeholder-output-replacements:
  "%world%":
{%- for world, (on_race, elsewhere) in tab_worlds.items() %}
{%- if on_race and elsewhere %}
    "world_{{ world }}": "%condition:race-{{ world }}%"
{%- else %}
    "world_{{ world }}": ": {{ on_race or elsewhere }}"
{%- endif %}
{%- endfor %}
    else: ""

conditions:
  map:
    conditions:
      - "%server%=freestyle"
      - "%server%=race"
    type: OR
    true: "%world%"
    false: ""
{%- for world, (on_race, elsewhere) in tab_worlds.items() if on_race and elsewhere %}
  race-{{ world }}:
    conditions:
      - "%server%=race"
    true: ": {{ on_race }}"
    false: ": {{ elsewhere }}"
{%- endfor %}
  # Only staff see vanished players in the tab list at all, so only they see this (mods/vanish).
  vanished:
    conditions:
      - "%vanished%=true"
    true: " <gray>[V]</gray>"
    false: ""
  ping-viewer:
    conditions:
      - "permission:propwash.ping.others"
    true: "yes"
    false: "no"

assign-groups-by-permissions: false
primary-group-finding-list:
  - default
permission-refresh-interval: 1000
debug: false

mysql:
  enabled: false

proxy-support:
  enabled: false

components:
  minimessage-support: true
  disable-shadow-for-heads: true

config-version: 7

use-bukkit-permissions-manager: false
use-online-uuid-in-tablist: true
compensate-for-packetevents-bug: false
per-world-playerlist:
  enabled: false
