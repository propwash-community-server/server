 package com.fabricplots.core;
 
+import java.io.Reader;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.Properties;
+
+import net.fabricmc.loader.api.FabricLoader;
+
 /**
  * Tunables for the plot grid. A "cell" is one plot plus the road on its
  * positive X/Z edges, so STEP = PLOT_SIZE + ROAD_WIDTH.
  */
 public final class PlotConfig {
-    /** Build area of a single plot, in blocks. */
-    public static final int PLOT_SIZE = 32;
+    /** Default for "plot-size" in config/fabricplots.properties. */
+    public static final int DEFAULT_PLOT_SIZE = 32;
+    /**
+     * Build area of a single plot, in blocks: "plot-size" in config/fabricplots.properties,
+     * read once at startup (not on /plot reload). Changing it needs a fresh plot world.
+     */
+    public static final int PLOT_SIZE = readPlotSize();
     /** Road gap: 3 sidewalk + 1 stair + 9 road + 1 stair + 3 sidewalk = 17. */
     public static final int ROAD_WIDTH = 17;
     /** Sidewalk depth on each side (road distance 0..2). Road distance 3 = transition stair. */
@@ -39,9 +51,28 @@ public final class PlotConfig {
     /** How often (ticks) to scan for stale unnamed mobs. */
     public static final int MOB_SCAN_INTERVAL_TICKS = 600; // 30s
 
-    /** /plot world drops players here — on the road plaza near plot (0,0). */
-    public static final int SPAWN_X = 40;
-    public static final int SPAWN_Z = 40;
+    /** /plot world drops players here — on the road plaza near plot (0,0): mid-road, 40 at the default size. */
+    public static final int SPAWN_X = PLOT_SIZE + ROAD_WIDTH / 2;
+    public static final int SPAWN_Z = SPAWN_X;
 
     private PlotConfig() {}
+
+    private static int readPlotSize() {
+        Path file;
+        try {
+            file = FabricLoader.getInstance().getConfigDir().resolve("fabricplots.properties");
+        } catch (Throwable t) { // no Fabric loader (unit tests): keep the default grid
+            return DEFAULT_PLOT_SIZE;
+        }
+        Properties p = new Properties();
+        if (Files.exists(file)) {
+            try (Reader r = Files.newBufferedReader(file)) { p.load(r); }
+            catch (Exception e) { System.err.println("[FabricPlots] Failed to read plot-size: " + e); }
+        }
+        try {
+            return Math.max(16, Math.min(512, Integer.parseInt(p.getProperty("plot-size", "" + DEFAULT_PLOT_SIZE).trim())));
+        } catch (NumberFormatException e) {
+            return DEFAULT_PLOT_SIZE;
+        }
+    }
 }
