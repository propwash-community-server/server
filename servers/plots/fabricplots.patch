+
+    /** The owner's plot "1", "2", ... or the one with that name; null, with a message listing them, if there's none. */
+    private static PlotData pickPlot(CommandContext<CommandSourceStack> ctx, UUID owner, String who, String arg) {
+        List<PlotData> owned = PlotManager.ownedPlots(owner);
+        if (arg == null || arg.isBlank()) return owned.get(0);
+        String a = arg.trim();
+        try {
+            int n = Integer.parseInt(a);
+            if (n >= 1 && n <= owned.size()) return owned.get(n - 1);
+        } catch (NumberFormatException ignored) {
+            for (PlotData d : owned) if (!d.name.isBlank() && d.name.equalsIgnoreCase(a)) return d;
+        }
+        StringBuilder sb = new StringBuilder((who.equals("You") ? "You have " : who + " has ") + owned.size()
+                + " plot" + (owned.size() == 1 ? "" : "s") + ":");
+        for (int i = 0; i < owned.size(); i++) sb.append(i == 0 ? " " : ", ").append(i + 1).append(label(owned.get(i)));
+        msg(ctx, sb.toString());
+        return null;
+    }
+
+    /** This plot's number among its owner's plots. */
+    private static int plotNumber(PlotData d) {
+        List<PlotData> owned = PlotManager.ownedPlots(d.owner);
+        for (int i = 0; i < owned.size(); i++) if (owned.get(i) == d) return i + 1;
+        return 1;
+    }
+
+    private static String label(PlotData d) {
+        return d.name.isBlank() ? "" : " (\"" + d.name + "\")";
+    }
+
+    private static java.util.concurrent.CompletableFuture<com.mojang.brigadier.suggestion.Suggestions> suggestPlots(
+            UUID owner, com.mojang.brigadier.suggestion.SuggestionsBuilder b) {
+        if (owner != null) {
+            List<PlotData> owned = PlotManager.ownedPlots(owner);
+            String typed = b.getRemaining().toLowerCase();
+            for (int i = 0; i < owned.size(); i++) {
+                String n = Integer.toString(i + 1);
+                if (n.startsWith(typed)) b.suggest(n);
+                String name = owned.get(i).name;
+                if (!name.isBlank() && name.toLowerCase().startsWith(typed)) b.suggest(name);
+            }
+        }
+        return b.buildFuture();
+    }
+
+    /** A plot owner by name, also when offline (the name is stored with their plots), else an online player. */
+    private static UUID ownerByName(CommandSourceStack src, String name) {
+        for (PlotData d : PlotManager.allPlots()) {
+            if (!PlotManager.isServer(d.owner) && d.ownerName != null && d.ownerName.equalsIgnoreCase(name)) return d.owner;
+        }
+        ServerPlayer online = src.getServer().getPlayerList().getPlayerByName(name);
+        return online == null ? null : online.getUUID();
+    }
