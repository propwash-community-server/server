@@ -0,0 +1,83 @@
+package com.fabricplots.core;
+
+import java.util.Map;
+import java.util.function.BiPredicate;
+import java.util.function.Predicate;
+import java.util.stream.Collectors;
+import java.util.stream.Stream;
+import net.minecraft.core.BlockPos;
+import net.minecraft.tags.BlockTags;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.entity.animal.Animal;
+import net.minecraft.world.entity.decoration.ArmorStand;
+import net.minecraft.world.entity.decoration.ItemFrame;
+import net.minecraft.world.entity.npc.villager.AbstractVillager;
+import net.minecraft.world.entity.vehicle.VehicleEntity;
+import net.minecraft.world.item.Item;
+import net.minecraft.world.item.ItemStack;
+import net.minecraft.world.item.Items;
+import net.minecraft.world.item.MinecartItem;
+import net.minecraft.world.level.Level;
+import net.minecraft.world.level.block.LeverBlock;
+import net.minecraft.world.level.block.state.BlockState;
+
+/**
+ * Per-plot flags for visitors (players who aren't the owner or trusted): what they may use on the
+ * plot. All off by default, so a plot is as closed as before. Building (placing, breaking) is never a
+ * flag: that stays owner and trusted only.
+ */
+public final class PlotFlags {
+    private PlotFlags() {}
+
+    public enum Flag {
+        VEHICLE_USE("vehicle-use", "ride minecarts", Items.MINECART),
+        VEHICLE_PLACE("vehicle-place", "place minecarts on rails", Items.RAIL),
+        DEVICE_INTERACT("device-interact", "use buttons, levers, doors, trapdoors and fence gates", Items.LEVER),
+        CONTAINER_USE("container-use", "open chests, barrels and other containers", Items.CHEST),
+        ANIMAL_INTERACT("animal-interact", "feed, ride and trade with animals and villagers", Items.WHEAT),
+        MISC_INTERACT("misc-interact", "use armor stands and item frames", Items.ARMOR_STAND),
+        // Not only visitors: with it on, anyone's drone (the owner's too) smashes glass here, and it comes back
+        // after the plot's glassRegenSeconds (mods/regen asks droneGlassSeconds). Off: glass never breaks.
+        DRONE_GLASS("drone-glass", "smash glass here with drones, anyone's (it comes back after /plot glassregen)", Items.GLASS);
+
+        public final String id;
+        public final String description;
+        public final Item icon;
+
+        Flag(String id, String description, Item icon) {
+            this.id = id;
+            this.description = description;
+            this.icon = icon;
+        }
+    }
+
+    private static final Map<String, Flag> BY_ID = Stream.of(Flag.values()).collect(Collectors.toMap(f -> f.id, f -> f));
+
+    public static Flag byId(String id) {
+        return BY_ID.get(id);
+    }
+
+    public static boolean on(PlotData plot, Flag flag) {
+        return plot != null && plot.flags.contains(flag.id);
+    }
+
+    /** A block visitors may right-click on this plot because of its flags. */
+    public static boolean allowsBlock(PlotData plot, Level level, BlockPos pos, BlockState state, ItemStack held) {
+        if (on(plot, Flag.DEVICE_INTERACT) && isDevice.test(state)) return true;
+        if (on(plot, Flag.CONTAINER_USE) && isContainer.test(level, pos)) return true;
+        return on(plot, Flag.VEHICLE_PLACE) && held.getItem() instanceof MinecartItem && state.is(BlockTags.RAILS);
+    }
+
+    /** An entity visitors may click on this plot because of its flags. */
+    public static boolean allowsEntity(PlotData plot, Entity entity) {
+        if (on(plot, Flag.VEHICLE_USE) && entity instanceof VehicleEntity) return true;
+        if (on(plot, Flag.ANIMAL_INTERACT) && (entity instanceof Animal || entity instanceof AbstractVillager)) return true;
+        return on(plot, Flag.MISC_INTERACT) && (entity instanceof ArmorStand || entity instanceof ItemFrame);
+    }
+
+    private static final Predicate<BlockState> isDevice = state -> state.is(BlockTags.DOORS) || state.is(BlockTags.TRAPDOORS)
+            || state.is(BlockTags.FENCE_GATES) || state.is(BlockTags.BUTTONS) || state.getBlock() instanceof LeverBlock;
+
+    private static final BiPredicate<Level, BlockPos> isContainer = (level, pos) ->
+            level.getBlockEntity(pos) instanceof net.minecraft.world.Container;
+}
