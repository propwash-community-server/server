+ * Plots over their owner's limit are locked: when a limit goes down (a supporter's time ends), the
+ * owner keeps their first plots, and the newest ones become server plots with every block on them
+ * (PlotData.frozen, lockedFor = the owner): anyone may walk in and look, nobody may build or use
+ * anything (only build-admin staff), nobody can claim them, and they're off the owner's /plot list
+ * and /plot home. They go back to the owner, as they are, once their limit allows them again.
+ * Checked for every owner at start, every 5 minutes (offline owners too: the permissions mod answers
+ * by UUID) and on join.
+ */
+public final class PlotLocks {
+    private PlotLocks() {}
+
+    private static final int EVERY_TICKS = 20 * 60 * 5;
+    private static int tick;
+
+    public static void tick(MinecraftServer server) {
+        if (++tick < EVERY_TICKS) return;
+        tick = 0;
+        checkAll(server);
+    }
+
+    /** Every owner with more than one plot, and everyone with locked plots. */
+    public static void checkAll(MinecraftServer server) {
+        Set<UUID> owners = new HashSet<>();
+        Set<UUID> seen = new HashSet<>();
+        for (PlotData d : PlotManager.allPlots()) {
+            if (d.lockedFor != null) owners.add(d.lockedFor);
+            else if (d.owner != null && !PlotManager.isServer(d.owner) && !seen.add(d.owner)) owners.add(d.owner);
+        }
+        for (UUID owner : owners) check(server, owner);
+    }
+
+    public static void check(MinecraftServer server, UUID owner) {
+        Perms.claimLimit(owner, PlotsConfig.claimLimit).thenAccept(limit -> server.execute(() -> apply(server, owner, limit)));
+    }
+
+    /** The owner's locked plots, oldest claim first. */
+    static List<PlotData> lockedOf(UUID owner) {
+        List<PlotData> out = new ArrayList<>();
+        for (PlotData d : PlotManager.allPlots()) if (owner.equals(d.lockedFor)) out.add(d);
+        out.sort(Comparator.comparingLong(d -> d.claimedAt));
+        return out;
+    }
+
+    /** Locks the owner's plots past limit (newest first), gives locked ones back up to it; 0 = no limit. */
+    static void apply(MinecraftServer server, UUID owner, int limit) {
+        List<PlotData> owned = PlotManager.ownedPlots(owner);
+        List<PlotData> locked = lockedOf(owner);
+        int nowLocked = 0;
+        int nowBack = 0;
+        if (limit > 0 && owned.size() > limit) {
+            for (PlotData d : owned.subList(limit, owned.size())) {
+                String name = d.ownerName;
+                if (PlotManager.update(d, plot -> {
+                    plot.lockedFor = owner;
+                    plot.lockedName = name;
+                    plot.owner = PlotManager.SERVER_UUID;
+                    plot.ownerName = "Server";
+                    plot.frozen = true;
+                })) nowLocked++;
+            }
+        } else {
+            int room = limit <= 0 ? locked.size() : Math.min(locked.size(), limit - owned.size());
+            for (PlotData d : locked.subList(0, Math.max(0, room))) {
+                String name = d.lockedName;
+                if (PlotManager.update(d, plot -> {
+                    plot.owner = owner;
+                    plot.ownerName = name;
+                    plot.lockedFor = null;
+                    plot.lockedName = "";
+                    plot.frozen = false;
+                })) nowBack++;
+            }
+        }
+        ServerPlayer player = server.getPlayerList().getPlayer(owner);
+        if (player == null) return;
+        if (nowLocked > 0) {
+            player.sendSystemMessage(Component.literal("[Plots] You can have " + limit + " plot" + (limit == 1 ? "" : "s")
+                    + " now, so " + count(nowLocked) + " of yours " + (nowLocked == 1 ? "is" : "are") + " locked: kept as "
+                    + (nowLocked == 1 ? "it is" : "they are") + " as a server plot (anyone can look, nobody can build)."
+                    + " You get " + (nowLocked == 1 ? "it" : "them") + " back when you can have more plots again (supporter)."));
+        }
+        if (nowBack > 0) {
+            player.sendSystemMessage(Component.literal("[Plots] " + capital(count(nowBack)) + " of your locked plots "
+                    + (nowBack == 1 ? "is" : "are") + " yours again, as you left " + (nowBack == 1 ? "it" : "them") + "."));
+        }
+    }
+
+    /** On join: tell the owner about locked plots, and check their limit now. */
+    public static void onJoin(MinecraftServer server, ServerPlayer player) {
+        int locked = lockedOf(player.getUUID()).size();
+        if (locked > 0) {
+            player.sendSystemMessage(Component.literal("[Plots] " + capital(count(locked)) + " of your plots "
+                    + (locked == 1 ? "is" : "are") + " locked (over your plot limit): kept as server plots, and yours again"
+                    + " when you can have more plots (supporter)."));
+        }
+        check(server, player.getUUID());
+    }
+
+    private static String count(int n) {
+        return n == 1 ? "one" : n == 2 ? "two" : n == 3 ? "three" : String.valueOf(n);
+    }
+
+    private static String capital(String s) {
+        return Character.toUpperCase(s.charAt(0)) + s.substring(1);
+    }
+}
