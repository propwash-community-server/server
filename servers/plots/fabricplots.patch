@@ -0,0 +1,31 @@
+package com.fabricplots.mixin;
+
+import com.fabricplots.FabricPlots;
+import com.fabricplots.protect.PlotProtection;
+
+import net.minecraft.core.BlockPos;
+import net.minecraft.server.level.ServerPlayer;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.level.Level;
+import net.minecraft.world.level.block.FarmlandBlock;
+import net.minecraft.world.level.block.state.BlockState;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.injection.At;
+import org.spongepowered.asm.mixin.injection.Inject;
+import org.spongepowered.asm.mixin.injection.callback.CallbackInfo;
+
+/**
+ * Players trample farmland whatever the game rules say (mobs only with mob_griefing, which is off on
+ * plots): in the plot world only a player who may build there does, so nobody can stomp the crops on
+ * someone else's plot. Farmland drying out (no player) is untouched.
+ */
+@Mixin(FarmlandBlock.class)
+public abstract class FarmlandTrampleMixin {
+    @Inject(method = "turnToBaseBlock", at = @At("HEAD"), cancellable = true)
+    private void fabricplots$noTrampling(Entity entity, BlockState state, Level level, BlockPos pos, CallbackInfo ci) {
+        if (entity instanceof ServerPlayer player && level.dimension() == FabricPlots.PLOTS_DIM
+                && !PlotProtection.canModifyEntity(player, pos)) {
+            ci.cancel();
+        }
+    }
+}
diff --git a/src/main/java/com/fabricplots/mixin/NoFallingBlocksMixin.java b/src/main/java/com/fabricplots/mixin/NoFallingBlocksMixin.java
new file mode 100644
index 0000000..0c2ec1b
--- /dev/null
+++ b/src/main/java/com/fabricplots/mixin/NoFallingBlocksMixin.java
@@ -0,0 +1,28 @@
+package com.fabricplots.mixin;
+
+import com.fabricplots.FabricPlots;
+
+import net.minecraft.core.BlockPos;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.util.RandomSource;
+import net.minecraft.world.level.block.FallingBlock;
+import net.minecraft.world.level.block.state.BlockState;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.injection.At;
+import org.spongepowered.asm.mixin.injection.Inject;
+import org.spongepowered.asm.mixin.injection.callback.CallbackInfo;
+
+/**
+ * Sand, gravel, concrete powder, anvils and the other gravity blocks don't fall in the plot world: they
+ * stay where they're placed. A shape of sand from WorldEdit or DraftSmith (a sphere: everything below
+ * its middle has nothing under it) turned thousands of blocks into falling ones at once, and their
+ * collision checks with each other froze the server until the watchdog stopped it. The fall starts in
+ * FallingBlock#tick, scheduled when the block is placed or a neighbour changes; here it does nothing.
+ */
+@Mixin(FallingBlock.class)
+public abstract class NoFallingBlocksMixin {
+    @Inject(method = "tick", at = @At("HEAD"), cancellable = true)
+    private void fabricplots$noFalling(BlockState state, ServerLevel level, BlockPos pos, RandomSource random, CallbackInfo ci) {
+        if (level.dimension() == FabricPlots.PLOTS_DIM) ci.cancel();
+    }
+}
diff --git a/src/main/java/com/fabricplots/player/DroneView.java b/src/main/java/com/fabricplots/player/DroneView.java
new file mode 100644
index 0000000..f931378
--- /dev/null
+++ b/src/main/java/com/fabricplots/player/DroneView.java
@@ -0,0 +1,58 @@
+package com.fabricplots.player;
+
+import java.lang.invoke.MethodHandle;
+import java.lang.invoke.MethodHandles;
+import java.lang.invoke.MethodType;
+import java.util.HashMap;
+import java.util.Map;
+import java.util.Optional;
+import java.util.UUID;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.server.level.ServerPlayer;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.level.entity.EntityTypeTest;
+
+/**
+ * Propwash drones and who flies them, so the per-plot sky (PlotAmbience) follows a pilot's drone and
+ * not where they stand. Propwash is used by name (QuadcopterEntity.pilot()); without it, nobody flies.
+ * Rebuilt every half second from the drones in the plot world.
+ */
+public final class DroneView {
+    private DroneView() {}
+
+    private static Class<? extends Entity> droneClass;
+    private static MethodHandle pilot;
+    private static final Map<UUID, Entity> FLOWN = new HashMap<>();
+    private static int tick;
+
+    static {
+        try {
+            droneClass = Class.forName("de.lardtom.propwash.drone.QuadcopterEntity").asSubclass(Entity.class);
+            pilot = MethodHandles.publicLookup().findVirtual(droneClass, "pilot", MethodType.methodType(Optional.class));
+        } catch (ReflectiveOperationException | LinkageError | ClassCastException e) {
+            droneClass = null; // no Propwash
+        }
+    }
+
+    /** Call every tick: every 10th, which drone each player in the plot world is flying. */
+    public static void refresh(ServerLevel plots) {
+        if (++tick < 10) return;
+        tick = 0;
+        FLOWN.clear();
+        if (droneClass == null || plots == null) return;
+        for (Entity drone : plots.getEntities(EntityTypeTest.forClass(droneClass), e -> true)) {
+            try {
+                Optional<?> who = (Optional<?>) pilot.invoke(drone);
+                if (who.isPresent() && who.get() instanceof UUID id) FLOWN.put(id, drone);
+            } catch (Throwable ignored) {
+                // a drone we can't read: as if nobody flew it
+            }
+        }
+    }
+
+    /** The drone this player is flying in their own world, or null. */
+    public static Entity flown(ServerPlayer player) {
+        Entity drone = FLOWN.get(player.getUUID());
+        return drone != null && !drone.isRemoved() && drone.level() == player.level() ? drone : null;
+    }
+}
